# ==============================================================================
# D&K E-Commerce Data Platform - Environment Configuration
# Copy this file to .env and update values for your environment.
# ==============================================================================

# --- Active Compose Profiles (PostgreSQL only by default) ---
# Launcher --profiles overrides this selection; use --all for all service groups.
COMPOSE_PROFILES=core

# --- Source PostgreSQL database (application code conversion is pending) ---
POSTGRES_ECOMMERCE_DB=ecommerce
POSTGRES_ECOMMERCE_USER=ecommerce_app
POSTGRES_ECOMMERCE_PASSWORD=password

# Dedicated PostgreSQL logical replication account for Debezium.
POSTGRES_CDC_USER=debezium
POSTGRES_CDC_PASSWORD=password
CDC_TOPIC_PREFIX=ecommerce
CDC_CONNECT_BIND_ADDRESS=127.0.0.1
CDC_CONNECT_PORT=8086

# --- Shared PostgreSQL service: ecommerce, Polaris and Airflow ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

# Polaris catalog database
POLARIS_DB_NAME=polaris
POLARIS_DB_USER=polaris
POLARIS_DB_PASSWORD=password

# Airflow metadata database
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=password

# --- Object Storage (MinIO) ---
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_ROOT_USER=minio-root
MINIO_ROOT_PASSWORD=lakehouse-root-dev-secret-2026
MINIO_LAKEHOUSE_BUCKET=lakehouse
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Per-service MinIO identities (dev-only values).
MINIO_POLARIS_ACCESS_KEY=lakehouse-polaris
MINIO_POLARIS_SECRET_KEY=lakehouse-polaris-dev-secret-2026
MINIO_SPARK_ACCESS_KEY=lakehouse-spark
MINIO_SPARK_SECRET_KEY=lakehouse-spark-dev-secret-2026
MINIO_FLINK_ACCESS_KEY=lakehouse-flink
MINIO_FLINK_SECRET_KEY=lakehouse-flink-dev-secret-2026
MINIO_TRINO_ACCESS_KEY=lakehouse-trino
MINIO_TRINO_SECRET_KEY=lakehouse-trino-dev-secret-2026

AWS_REGION=us-east-1

# --- Apache Iceberg ---
ICEBERG_VERSION=1.10.1

# --- Apache Spark (local execution inside each job container) ---
SPARK_MASTER_URL=local[2]

# --- Apache Polaris (REST Catalog) ---
POLARIS_REALM=POLARIS
POLARIS_CATALOG_NAME=lakehouse
POLARIS_ROOT_CLIENT_ID=root
POLARIS_ROOT_CLIENT_SECRET=lakehouse-polaris-root-dev-secret-2026
POLARIS_BIND_ADDRESS=127.0.0.1
POLARIS_API_PORT=8181
POLARIS_MANAGEMENT_PORT=8182
POLARIS_CONSOLE_PORT=8183
POLARIS_CONSOLE_ORIGIN=http://localhost:8183
POLARIS_PUBLIC_API_URL=http://localhost:8181

# --- Trino (Query Engine) ---
TRINO_BIND_ADDRESS=127.0.0.1
TRINO_PORT=8084

# --- Main Console (Python / Streamlit) ---
PLATFORM_APP_BIND_ADDRESS=127.0.0.1
PLATFORM_APP_PORT=8501
PLATFORM_APP_UID=1000
PLATFORM_APP_GID=1000
API_PORT=8000
API_SECRET_KEY=change-me-with-at-least-32-random-characters
API_CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# --- Apache Airflow (Orchestration) ---
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
AIRFLOW_SECRET_KEY=change-me-airflow-secret
AIRFLOW_JWT_SECRET=change-me-airflow-jwt-secret
AIRFLOW_FERNET_KEY=
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=password
