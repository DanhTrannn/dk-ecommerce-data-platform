# ==============================================================================
# D&K E-Commerce Data Platform - Environment Configuration
# Copy this file to .env and update values for your environment.
# ==============================================================================

# --- Compose profiles ---
# core: PostgreSQL, MinIO, Polaris, Airflow (with the Polars/PyIceberg/dbt runtime), Trino,
#       platform-app (FastAPI + Streamlit), admin bootstrap and credential exporter.
# streaming: adds Kafka and Flink for API access logs; Flink job submission remains manual.
# `make up` overrides this with PROFILES (default: core):
# make up starts platform-app and its dependencies; use make up-all to start full selected profiles.
#   make up-all PROFILES=core,streaming
COMPOSE_PROFILES=core

# --- Source PostgreSQL database ---
POSTGRES_ECOMMERCE_DB=ecommerce
POSTGRES_ECOMMERCE_USER=ecommerce_app
POSTGRES_ECOMMERCE_PASSWORD=password

# Batch reader: set a nonempty password, recreate PostgreSQL, then run make source-reader.
# airflow-init copies these into the Airflow connection oltp_postgres on first start.
POSTGRES_ECOMMERCE_READER_USER=ecommerce_reader
POSTGRES_ECOMMERCE_READER_PASSWORD=

# --- Shared PostgreSQL service: ecommerce, Polaris and Airflow ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

# Polaris catalog database
POLARIS_DB_NAME=polaris
POLARIS_DB_USER=polaris
POLARIS_DB_PASSWORD=password

# Airflow metadata database
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=password

# --- Object Storage (MinIO) ---
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_ROOT_USER=minio-root
MINIO_ROOT_PASSWORD=lakehouse-root-dev-secret-2026
MINIO_LAKEHOUSE_BUCKET=lakehouse
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Per-service MinIO identities (dev-only values).
# Compose passes only the Polaris pair; Airflow, Flink and Trino get storage credentials vended by Polaris.
# The other pairs name the MinIO users to create in Streamlit.
# Choose credentials before first initialization; editing .env alone does not rotate them.
MINIO_POLARIS_ACCESS_KEY=lakehouse-polaris
MINIO_POLARIS_SECRET_KEY=lakehouse-polaris-dev-secret-2026
MINIO_BATCH_ACCESS_KEY=lakehouse-batch
MINIO_BATCH_SECRET_KEY=lakehouse-batch-dev-secret-2026
MINIO_FLINK_ACCESS_KEY=lakehouse-flink
MINIO_FLINK_SECRET_KEY=lakehouse-flink-dev-secret-2026
MINIO_TRINO_ACCESS_KEY=lakehouse-trino
MINIO_TRINO_SECRET_KEY=lakehouse-trino-dev-secret-2026

AWS_REGION=us-east-1

# --- Apache Iceberg runtime for the Flink image ---
ICEBERG_VERSION=1.10.1

# --- Apache Polaris (REST Catalog) ---
# Bootstrap creates realm/root only; create workload principals/roles and assign credentials in Streamlit.
# Keep existing root secrets on retained volumes.
# The current Compose stack does not run a Polaris Console. POLARIS_CONSOLE_ORIGIN is only
# the allowed CORS origin if you run an external console.
POLARIS_REALM=POLARIS
# Trino catalog .properties files currently use the literal warehouse lakehouse.
# Changing this value alone does not rewrite those files.
POLARIS_CATALOG_NAME=lakehouse
POLARIS_ROOT_CLIENT_ID=root
POLARIS_ROOT_CLIENT_SECRET=lakehouse-polaris-root-dev-secret-2026
POLARIS_BIND_ADDRESS=127.0.0.1
POLARIS_API_PORT=8181
POLARIS_MANAGEMENT_PORT=8182
POLARIS_CONSOLE_ORIGIN=http://localhost:8183

# --- Trino (Query Engine) ---
TRINO_BIND_ADDRESS=127.0.0.1
TRINO_PORT=8084

# --- Platform app (FastAPI + Streamlit) ---
PLATFORM_APP_BIND_ADDRESS=127.0.0.1
PLATFORM_APP_PORT=8501
PLATFORM_APP_UID=1000
PLATFORM_APP_GID=1000
API_PORT=8000
# At least 32 characters; change for shared or non-local deployments.
API_SECRET_KEY=change-me-with-at-least-32-random-characters
API_CORS_ORIGINS=http://localhost:8501
# Total attempts for retryable PostgreSQL transaction aborts (minimum 1).
API_CHECKOUT_MAX_RETRIES=3

# Host-side API database URL. Compose injects the internal postgres URL for the API and access admin.
API_DATABASE_URL=postgresql+psycopg2://${POSTGRES_ECOMMERCE_USER}:${POSTGRES_ECOMMERCE_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_ECOMMERCE_DB}

# Host-side database URL for `make generate`; the generator writes synthetic history here (empty database only).
GENERATOR_DATABASE_URL=postgresql://${POSTGRES_ECOMMERCE_USER}:${POSTGRES_ECOMMERCE_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_ECOMMERCE_DB}

# platform-admin-init creates this admin on first startup; existing passwords are preserved.
# Only this configured identity can manage MinIO/Polaris through Streamlit.
API_BOOTSTRAP_ADMIN_EMAIL=admin@web.local
API_BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
API_BOOTSTRAP_ADMIN_DISPLAY_NAME=Admin

# Host-side analytics over Trino; Compose uses https://trino:8443 internally.
# API_TRINO_URL=https://127.0.0.1:8084
# TRINO_CA_FILE=/absolute/path/to/the/generated-trino-ca.pem
# Host API also needs TRINO_READER_PASSWORD in its process environment.
# API_ANALYTICS_CACHE_MAX_AGE_SECONDS=3600

# Streamlit API scenarios: server-side API origin, no credentials or path.
# Compose uses the API in the same container on port 8000.
SCENARIO_API_BASE_URL=http://127.0.0.1:8000
SCENARIO_HTTP_TIMEOUT_SECONDS=15

# Platform Console host paths. The image sets /app and /data/scenarios.
# PLATFORM_APP_REPO_ROOT=/absolute/path/to/repo
# PLATFORM_APP_SCENARIOS_DIR=/absolute/path/to/repo/data/scenarios

# Streamlit access management uses the shared FastAPI on port 8000, also inside Compose.
CONSOLE_ACCESS_ADMIN_URL=http://127.0.0.1:8000
# Local audit journal (Compose fixes this path to /data/access-admin/audit.jsonl).
ACCESS_ADMIN_AUDIT_PATH=data/access-admin/audit.jsonl
# Host-run FastAPI access administration; Compose injects its own URLs and credentials.
# ACCESS_ADMIN_MC_BINARY=mc
# ACCESS_ADMIN_MINIO_URL=http://127.0.0.1:9000
# ACCESS_ADMIN_POLARIS_URL=http://127.0.0.1:8181

# --- Apache Airflow (Orchestration) ---
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
# Change these for shared or non-local deployments.
AIRFLOW_SECRET_KEY=change-me-airflow-secret
AIRFLOW_JWT_SECRET=change-me-airflow-jwt-secret
AIRFLOW_FERNET_KEY=
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=password

# --- Streaming: Kafka and Flink ---
# The streaming profile starts infrastructure only; Flink job submission is manual.
# Kafka host port; the external advertised listener remains localhost:9094.
KAFKA_PORT=9092
FLINK_JOBMANAGER_PORT=8085

# Compose access-log streaming is opt-in: set KAFKA_ENABLED=true when using streaming.
# false disables Kafka delivery and DLQ writes; structured access logs remain.
# Host commands must load/export KAFKA_* (uv run --env-file .env); the producer reads os.environ.
# Compose uses kafka:9092 and /data/events/dlq_access_logs.jsonl; the following paths are for host-run API.
# KAFKA_ACCESS_LOG_TOPIC is shared by platform-app, kafka-init and the Flink access job.
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_ACCESS_LOG_TOPIC=ecommerce.access_logs
KAFKA_DLQ_FILE_PATH=data/events/dlq_access_logs.jsonl


# --- Optional Superset BI (profile bi) ---
# Set independent random secrets before explicit metadata initialization; no default passwords.
SUPERSET_SECRET_KEY=
SUPERSET_DB_NAME=superset
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_EMAIL=bi-admin@example.com
SUPERSET_ADMIN_PASSWORD=
SUPERSET_BIND_ADDRESS=127.0.0.1
SUPERSET_PORT=8088
# Local HTTP defaults; set only when deploying behind a trusted HTTPS proxy.
SUPERSET_COOKIE_SECURE=false
SUPERSET_PROXY_FIX=false

# Trino authenticates BI separately from the dbt writer over private HTTPS.
TRINO_READER_PASSWORD=reader-dev-password-change-me
DBT_TRINO_PASSWORD=dbt-dev-password-change-me
TRINO_INTERNAL_SECRET=local-internal-trino-secret-change-before-deployment
