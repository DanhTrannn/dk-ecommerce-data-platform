# ==============================================================================
# D&K E-Commerce Data Platform - Environment Configuration
# Copy this file to .env and update values for your environment.
# ==============================================================================

# --- Active Compose Profiles: core, batch, streaming ---
# Make uses PROFILES to override this selection (default: core).
COMPOSE_PROFILES=core

# --- Source PostgreSQL database ---
POSTGRES_ECOMMERCE_DB=ecommerce
POSTGRES_ECOMMERCE_USER=ecommerce_app
POSTGRES_ECOMMERCE_PASSWORD=password

# Dedicated batch reader: set a password, then run make source-reader after schema bootstrap.
POSTGRES_ECOMMERCE_READER_USER=ecommerce_reader
POSTGRES_ECOMMERCE_READER_PASSWORD=
# Host-side batch connection; Compose fixes the internal address to postgres:5432.
POSTGRES_SOURCE_HOST=127.0.0.1
POSTGRES_SOURCE_PORT=5432

# Dedicated PostgreSQL logical replication account for Debezium.
# After schema bootstrap, run make source-cdc for SELECT grants, publication and FULL replica identity.
# Retained PostgreSQL containers need the new script mount; connector publication auto-creation is disabled.
POSTGRES_CDC_USER=debezium
POSTGRES_CDC_PASSWORD=password
CDC_TOPIC_PREFIX=ecommerce
CDC_CONNECT_BIND_ADDRESS=127.0.0.1
CDC_CONNECT_PORT=8086

# --- Shared PostgreSQL service: ecommerce, Polaris and Airflow ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

# Polaris catalog database
POLARIS_DB_NAME=polaris
POLARIS_DB_USER=polaris
POLARIS_DB_PASSWORD=password

# Airflow metadata database
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=password

# --- Object Storage (MinIO) ---
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_ROOT_USER=minio-root
MINIO_ROOT_PASSWORD=lakehouse-root-dev-secret-2026
MINIO_LAKEHOUSE_BUCKET=lakehouse
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Per-service MinIO identities (dev-only values).
# make provision-lakehouse creates missing accounts; existing secrets/policies are preserved.
# Choose credentials before first initialization; editing .env alone does not rotate them.
MINIO_POLARIS_ACCESS_KEY=lakehouse-polaris
MINIO_POLARIS_SECRET_KEY=lakehouse-polaris-dev-secret-2026
MINIO_SPARK_ACCESS_KEY=lakehouse-spark
MINIO_SPARK_SECRET_KEY=lakehouse-spark-dev-secret-2026
MINIO_FLINK_ACCESS_KEY=lakehouse-flink
MINIO_FLINK_SECRET_KEY=lakehouse-flink-dev-secret-2026
MINIO_TRINO_ACCESS_KEY=lakehouse-trino
MINIO_TRINO_SECRET_KEY=lakehouse-trino-dev-secret-2026

AWS_REGION=us-east-1

# --- Apache Iceberg ---
ICEBERG_VERSION=1.10.1

# --- Apache Spark (local execution inside each job container) ---
SPARK_MASTER_URL=local[2]

# --- Apache Polaris (REST Catalog) ---
# RBAC YAML applies only on first provisioning; keep existing root secrets on retained volumes.
POLARIS_REALM=POLARIS
POLARIS_CATALOG_NAME=lakehouse
POLARIS_ROOT_CLIENT_ID=root
POLARIS_ROOT_CLIENT_SECRET=lakehouse-polaris-root-dev-secret-2026
POLARIS_BIND_ADDRESS=127.0.0.1
POLARIS_API_PORT=8181
POLARIS_MANAGEMENT_PORT=8182
POLARIS_CONSOLE_PORT=8183
POLARIS_CONSOLE_ORIGIN=http://localhost:8183
POLARIS_PUBLIC_API_URL=http://localhost:8181

# --- Trino (Query Engine) ---
TRINO_BIND_ADDRESS=127.0.0.1
TRINO_PORT=8084

# --- Main Console (Python / Streamlit) ---
PLATFORM_APP_BIND_ADDRESS=127.0.0.1
PLATFORM_APP_PORT=8501
PLATFORM_APP_UID=1000
PLATFORM_APP_GID=1000
API_PORT=8000
API_SECRET_KEY=change-me-with-at-least-32-random-characters
API_CORS_ORIGINS=http://localhost:8501,http://localhost:3000
# Total attempts for retryable PostgreSQL transaction aborts (minimum 1).
API_CHECKOUT_MAX_RETRIES=3

# --- Apache Airflow (Orchestration) ---
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
AIRFLOW_SECRET_KEY=change-me-airflow-secret
AIRFLOW_JWT_SECRET=change-me-airflow-jwt-secret
AIRFLOW_FERNET_KEY=
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=password

# Source URL for FastAPI and explicit Streamlit job imports; schema/seed remain manual.
# Host-side connection; Compose injects its internal postgres URL separately.
API_DATABASE_URL=postgresql+psycopg2://${POSTGRES_ECOMMERCE_USER}:${POSTGRES_ECOMMERCE_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_ECOMMERCE_DB}

# Streamlit API scenarios: server-side API origin, no credentials or path.
# Compose uses the API in the same container on port 8000.
SCENARIO_API_BASE_URL=http://127.0.0.1:8000
SCENARIO_HTTP_TIMEOUT_SECONDS=15

# Required for Silver PII tokenization; choose a stable nonempty secret.
SILVER_PSEUDONYMIZE_SALT=

# Streamlit access management: local internal API; Compose uses lakehouse-access:8010.
CONSOLE_ACCESS_ADMIN_URL=http://127.0.0.1:8010
# Local audit journal (Compose fixes this path to /data/access-admin/audit.jsonl).
ACCESS_ADMIN_AUDIT_PATH=data/access-admin/audit.jsonl

# Access-log streaming is opt-in: set KAFKA_ENABLED=true when using the streaming profile.
# Compose uses kafka:9092 and /data/events/dlq_access_logs.jsonl; the following paths are for host-run API.
# KAFKA_ACCESS_LOG_TOPIC is shared by platform-app, kafka-init and the Flink access job.
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_ACCESS_LOG_TOPIC=ecommerce.access_logs
KAFKA_DLQ_FILE_PATH=data/events/dlq_access_logs.jsonl
